# SEITH environment configuration
# Copy ke .env lalu isi nilai. JANGAN PERNAH commit file .env.

SEITH_ENVIRONMENT=paper

# --- LLM ---
# PROVIDER: 'openrouter' | 'groq'. Katalog model berubah cepat - verifikasi dulu.
# OpenRouter free tier: 50 req/hari (naik 1000/hari setelah top-up $10 sekali).
SEITH_LLM__API_KEY=
SEITH_LLM__PROVIDER=openrouter
SEITH_LLM__QUICK_MODEL=z-ai/glm-5.2:free
SEITH_LLM__DEEP_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SEITH_LLM__MAX_RETRIES=3
SEITH_LLM__CACHE_TTL_SECONDS=3600

# --- Telegram bot ---
# Buat bot via @BotFather. ALLOWED_USER_IDS = telegram id kamu, format JSON array.
# CHANNEL_ID opsional: id channel broadcast komunitas (bot harus jadi admin).
SEITH_TELEGRAM__BOT_TOKEN=
SEITH_TELEGRAM__ALLOWED_USER_IDS=[]
SEITH_TELEGRAM__CHANNEL_ID=

# --- Binance (paper phase: kosongkan; saat live: TRADE-ONLY key, tanpa withdrawal) ---
SEITH_BINANCE__API_KEY=
SEITH_BINANCE__API_SECRET=

# --- OANDA v20 (forex practice account) ---
SEITH_OANDA__ACCESS_TOKEN=
SEITH_OANDA__ACCOUNT_ID=
SEITH_OANDA__ENVIRONMENT=practice

# --- Kronos ---
SEITH_KRONOS__MODEL_NAME=NeoQuasar/Kronos-base
SEITH_KRONOS__TOKENIZER_NAME=NeoQuasar/Kronos-Tokenizer-base
SEITH_KRONOS__DEVICE=cuda

# --- Paths ---
SEITH_DATA_DIR=data
SEITH_DB_PATH=data/seith.db

# --- Risk limits default ---
SEITH_RISK__MAX_POSITION_PCT=0.10
SEITH_RISK__MAX_DAILY_LOSS_PCT=0.03
SEITH_RISK__MAX_DRAWDOWN_PCT=0.10
SEITH_RISK__MAX_OPEN_POSITIONS=10
SEITH_RISK__REQUIRE_APPROVAL=true
